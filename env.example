# Puffin Journal configuration. Copy to .env and set APP_PASSWORD; everything
# else has a working default. .env is gitignored: never commit it.

# --- Login -------------------------------------------------------------------
# Username for the single account.
APP_USERNAME=me
# REQUIRED. Your password (at least 8 characters). Hashed in memory at startup;
# changing it logs out every session. Wrap in single quotes if it contains $ or #.
APP_PASSWORD=

# Optional alternative to APP_PASSWORD: an argon2 hash, so the plain password
# isn't stored in this file. Takes precedence if set. Generate with:
#   docker compose run --rm app python -m app.cli hash-password
# APP_PASSWORD_HASH='$argon2id$...'

# Optional. Secret used to sign session cookies. Leave empty and one is
# generated on first start and kept in ./data/secret_key. Changing it logs out
# every session.
SECRET_KEY=

# --- Time --------------------------------------------------------------------
# IANA timezone. Decides what "today" is for check-ins (and later, reminders).
TZ=Europe/Berlin

# --- Network -----------------------------------------------------------------
# Host port published by docker compose.
PORT=8000
# Send the session cookie only over HTTPS. Set to false ONLY for plain-HTTP use
# on a trusted LAN or Tailscale without TLS, or you won't be able to log in.
COOKIE_SECURE=true
# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted
# (used for the login rate limit). "*" trusts any; keep the default if there is no proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Log every request path (never bodies). Off by default because search terms
# appear in URLs.
LOG_ACCESS=false

# --- Container user ----------------------------------------------------------
# uid/gid the container runs as. Must own ./data on the host (check with `id`).
PUID=1000
PGID=1000

# --- Reminders (Phase 4, not used yet) ----------------------------------------
# ntfy server and topic for the daily reminder push.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Local time (HH:MM, in TZ) to send the reminder.
REMINDER_TIME=20:30
