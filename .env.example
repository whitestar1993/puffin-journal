# Puffin Journal configuration. Copy to .env and fill in.
# Values in single quotes are taken literally (needed for the password hash, which contains $).

# --- Login (required) --------------------------------------------------------
# Username for the single account.
APP_USERNAME=me
# argon2 hash of your password. Generate it with:
#   docker compose run --rm app python -m app.cli hash-password
# and paste the output here inside single quotes.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
# Random secret used to sign session cookies (at least 32 chars). Generate with:
#   docker compose run --rm app python -m app.cli secret-key
# Changing it logs out every session.
SECRET_KEY=change-me-to-a-long-random-string

# --- Time --------------------------------------------------------------------
# IANA timezone. Decides what "today" is for check-ins (and later, reminders).
TZ=Europe/Berlin

# --- Network -----------------------------------------------------------------
# Host port published by docker compose.
PORT=8000
# Send the session cookie only over HTTPS. Set to false ONLY for plain-HTTP use
# on a trusted LAN or Tailscale without TLS, or you won't be able to log in.
COOKIE_SECURE=true
# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted
# (used for the login rate limit). "*" trusts any; keep the default if there is no proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Log every request path (never bodies). Off by default because search terms
# appear in URLs.
LOG_ACCESS=false

# --- Container user ----------------------------------------------------------
# uid/gid the container runs as. Must own ./data on the host (check with `id`).
PUID=1000
PGID=1000

# --- Reminders (Phase 4, not used yet) ----------------------------------------
# ntfy server and topic for the daily reminder push.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Local time (HH:MM, in TZ) to send the reminder.
REMINDER_TIME=20:30
